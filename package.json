{
  "name": "memolog",
  "version": "0.1.0",
  "private": true,
  "description": "Prise de notes locale, rapide, en Markdown",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @memolog/desktop dev",
    "build": "pnpm --filter @memolog/core build && pnpm --filter @memolog/desktop build",
    "dist": "pnpm build && pnpm --filter @memolog/desktop dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@9.12.3"
}
